{
  "name": "monitor-pases",
  "displayName": "RDR Coding",
  "description": "RDR Coding by NFQ: GitHub BBVA, Jira, DPs y el pase en VS Code.",
  "version": "2.3.0",
  "publisher": "nfq",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "media/icono.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "monitorPases.abrir",
        "title": "Abrir RDR Coding",
        "category": "RDR Coding",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "monitorPases.iniciarJira",
        "title": "Iniciar sesión en Jira (abre Chrome)",
        "category": "RDR Coding"
      },
      {
        "command": "monitorPases.sincronizar",
        "title": "Actualizar ahora",
        "category": "RDR Coding",
        "icon": "$(sync)"
      },
      {
        "command": "monitorPases.abrirNavegador",
        "title": "Abrir en el navegador",
        "category": "RDR Coding"
      },
      {
        "command": "monitorPases.abrirDemo",
        "title": "Probar la demo (datos inventados)",
        "category": "RDR Coding"
      },
      {
        "command": "monitorPases.reiniciar",
        "title": "Reiniciar el motor",
        "category": "RDR Coding"
      },
      {
        "command": "monitorPases.detener",
        "title": "Detener el motor",
        "category": "RDR Coding"
      },
      {
        "command": "monitorPases.verRegistro",
        "title": "Ver el registro",
        "category": "RDR Coding"
      },
      {
        "command": "monitorPases.carpetaDatos",
        "title": "Abrir la carpeta de datos",
        "category": "RDR Coding"
      },
      {
        "command": "monitorPases.elegirPython",
        "title": "Elegir Python…",
        "category": "RDR Coding"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "monitorPases",
          "title": "RDR Coding",
          "icon": "media/icono.svg"
        }
      ]
    },
    "views": {
      "monitorPases": [
        {
          "type": "webview",
          "id": "monitorPases.inicio",
          "name": "RDR Coding"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "monitorPases.sincronizar",
          "when": "view == monitorPases.inicio",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "RDR Coding",
      "properties": {
        "monitorPases.python": {
          "type": "string",
          "default": "",
          "markdownDescription": "Ruta de `python.exe` (3.8 o superior). Vacío: el lanzador `py -3` o el `python` del PATH."
        },
        "monitorPases.puerto": {
          "type": "number",
          "default": 0,
          "description": "Puerto local del motor. 0: el de siempre (8765, o el siguiente libre)."
        },
        "monitorPases.abrirAlPulsarIcono": {
          "type": "boolean",
          "default": true,
          "description": "Al pulsar el icono de la barra de actividad, abrir RDR Coding directamente (sin la barra lateral)."
        },
        "monitorPases.abrirAlIniciar": {
          "type": "boolean",
          "default": false,
          "description": "Abrir RDR Coding al arrancar VS Code."
        }
      }
    }
  }
}
